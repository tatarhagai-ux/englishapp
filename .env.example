# Copy to .env.local for local development. On Vercel, add these under
# Settings -> Environment Variables. Never commit real values.

# Access gate (required on Vercel before any paid API works)
APP_ACCESS_CODE=
# 32+ random characters, e.g. from: openssl rand -hex 32
APP_SESSION_SECRET=

# Azure Speech (F0 free tier): STT, TTS, pronunciation assessment
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# OpenRouter: one key for DeepSeek and other models
OPENROUTER_API_KEY=
LLM_CHAT_MODEL=deepseek/deepseek-v3.2
LLM_ANALYZER_MODEL=deepseek/deepseek-v3.2

# Supabase (used from the next build step)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MONTHLY_BUDGET_USD=15
